# Leave empty to use the built-in browser mock (no backend needed).
# Set to /api/v1 to call the backend through the Vite dev proxy below.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests:
#   http://localhost:3000 for a local backend or `npm run mock:api`
#   https://node-express-js-prisma-psql-boilerplate-production.up.railway.app for the deployed backend
VITE_API_PROXY_TARGET=http://localhost:3000
